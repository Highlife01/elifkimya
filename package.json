{
  "name": "elif-kimya-premium-b2b",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/extract-translations.mjs --check && node scripts/verify-translations.mjs && vite build && node scripts/prerender-html.mjs && node scripts/verify-multilingual-seo.mjs",
